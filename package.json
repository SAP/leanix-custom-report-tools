{
  "name": "@sap/leanix-custom-report-tools",
  "version": "2.2.0",
  "private": true,
  "description": "Monorepo for SAP LeanIX custom report development tools",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/leanix-custom-report-tools.git"
  },
  "keywords": [
    "sap",
    "leanix",
    "custom-reports",
    "vite",
    "vite-plugin",
    "creation"
  ],
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "clean:all": "npm run clean & rimraf \"**/node_modules\"",
    "clean": "rimraf \"packages/**/dist\" \"**/*.tsbuildinfo\" \"**/*.tgz\" \"**/.temp\"",
    "build:vite-plugin": "npm run build -w=@sap/vite-plugin-leanix-custom-report",
    "build:create-custom-report": "npm run build -w=@sap/create-leanix-custom-report",
    "build": "npm run build:vite-plugin && npm run build:create-custom-report",
    "test:core": "vitest run packages/core",
    "test:create-custom-report": "vitest run packages/create-custom-report",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/vite-plugin/tsconfig.json && tsc --noEmit -p packages/create-custom-report/tsconfig.json",
    "lint": "eslint --fix",
    "format": "prettier --write .",
    "update": "npx npm-check-updates@latest -u",
    "create-custom-report-local": "node ./scripts/create-custom-report-local.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "tsup": "8.5.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "lefthook": "2.1.12",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
