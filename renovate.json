{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["group:allNonMajor"],
  "addLabels": ["renovate"],
  "timezone": "Europe/Berlin",
  "osvVulnerabilityAlerts": true,
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "minimumReleaseAge": "5 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "vulnerabilityAlerts": {
    "automerge": true,
    "platformAutomerge": true,
    "prCreation": "not-pending",
    "internalChecksFilter": "strict",
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": "5 days",
    "addLabels": ["SEVERITY:{{vulnerabilitySeverity}}"],
    "commitMessageSuffix": "[SECURITY] [SEVERITY: {{vulnerabilitySeverity}}{{#if (or (equals vulnerabilitySeverity 'MEDIUM') (equals vulnerabilitySeverity 'MODERATE'))}} 🟡{{else if (or (equals vulnerabilitySeverity 'HIGH') (equals vulnerabilitySeverity 'CRITICAL'))}} 🔴{{/if}}]",
    "vulnerabilityFixStrategy": "lowest"
  },
  "automergeType": "pr",
  "automergeStrategy": "auto",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "prCreation": "not-pending",
  "prNotPendingHours": 0,
  "rebaseWhen": "conflicted",
  "updateNotScheduled": false,
  "schedule": ["* 7-15 * * 1-5"],
  "automergeSchedule": ["* 7-15 * * 1-5"],
  "automerge": false,
  "prConcurrentLimit": 2,
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "5 days"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@leanix/*"],
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Keep caret ranges for reporting & vite-plugin packages in the project template. Deprecation mechanism relies on them so users get plugin/SDK updates automatically.",
      "matchFileNames": [
        "packages/create-custom-report/templates/**/package.json"
      ],
      "matchPackageNames": [
        "@leanix/reporting",
        "@sap/vite-plugin-leanix-custom-report"
      ],
      "rangeStrategy": "replace"
    }
  ]
}
