{
  "name": "@sap/create-leanix-custom-report",
  "type": "module",
  "version": "3.0.1",
  "description": "Creation tool to quickly create new SAP LeanIX custom reports",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/leanix-custom-report-tools.git",
    "directory": "packages/create-custom-report"
  },
  "keywords": [
    "sap",
    "leanix",
    "custom-reports",
    "creation",
    "cli"
  ],
  "main": "dist/index.cjs",
  "bin": {
    "create-leanix-custom-report": "dist/index.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup && shx cp -rL ./templates/ ./dist && chmod -R 755 ./dist/"
  },
  "dependencies": {
    "kolorist": "1.8.0",
    "minimist": "1.2.8",
    "prompts": "2.4.2",
    "semver": "7.8.5",
    "short-uuid": "6.0.3",
    "undici": "8.5.0"
  },
  "engines": {
    "node": ">=22.0.0 <26.0.0 || >=26.1.0"
  },
  "devDependencies": {
    "@types/fs-extra": "11.0.4",
    "@types/minimist": "1.2.5",
    "@types/prompts": "2.4.9",
    "@types/semver": "7.7.1",
    "fs-extra": "11.3.6"
  }
}
