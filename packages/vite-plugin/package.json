{
  "name": "@sap/vite-plugin-leanix-custom-report",
  "type": "module",
  "version": "9.0.3",
  "description": "Vite plugin for developing SAP LeanIX Custom Reports",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SAP/leanix-custom-report-tools.git",
    "directory": "packages/vite-plugin"
  },
  "keywords": [
    "vite-plugin",
    "leanix"
  ],
  "bin": {
    "lxr": "./dist/cli.cjs"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
