  },
  "peerDependencies": {
    "vite": "^8.0.5"
  },
  "engines": {
    "node": ">=22.0.0 <26.0.0 || >=26.1.0"
  },
  "dependencies": {
    "http-proxy-middleware": "4.2.0",
    "cli-table3": "^0.6.5"
  },
  "devDependencies": {}
}